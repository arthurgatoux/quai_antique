html {
  position: relative;
  min-height: 100%;
}

main {
  margin-bottom: 270px;
}

footer.footer {
  padding: 15px;
  position: absolute;
  bottom: 0;
  width: 100%;
}

p {
  font-family: "Hind Madurai", serif;
  font-size: 18px;
}

.hero-scene {
  position: relative;
  margin-bottom: 15px;
}
.hero-scene::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url("../images/hero-accueil.png");
  background-size: cover;
  filter: brightness(0.3);
}
.hero-scene * {
  position: relative;
}
.hero-scene .hero-scene-content {
  height: 400px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.text-justify {
  text-align: justify;
}

.gap-large {
  --bs-gutter-x: 5rem;
}

.image-card {
  position: relative;
}
.image-card:hover .titre-image,
.image-card:hover .action-image-buttons {
  opacity: 1;
}
.image-card:hover img {
  filter: brightness(0.3);
}
.image-card img {
  transition: all 0.3s;
}
.image-card .titre-image {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  opacity: 0;
  transition: all 0.3s;
}
.image-card .action-image-buttons {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  padding: 5px;
  display: flex;
  justify-content: space-between;
  opacity: 0;
  transition: all 0.3s;
}

.form-label {
  color: #906427;
}

.allreservations a {
  display: block;
  color: #292222;
  padding: 10px;
}

.loader-overlay {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.85);
  transition: opacity 0.2s ease;
}/*# sourceMappingURL=main.css.map */
