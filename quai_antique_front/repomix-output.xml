<file path="scss/main.scss">
@import url("/node_modules/bootstrap-icons/font/bootstrap-icons.css");
@import 'custom';

html {
    position: relative;
    min-height: 100%;
}

main {
    margin-bottom: 270px;
}

footer.footer {
    padding: 15px;
    position: absolute;
    bottom: 0;
    width: 100%;
}

p {
    font-family: $font-family-serif;
    font-size: 18px;
}

.hero-scene {
    position: relative;
    margin-bottom: 15px;

    &::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('../images/hero-accueil.png');
        background-size: cover;
        filter: brightness(0.3);
    }

    * {
        position: relative;
    }

    .hero-scene-content {
        height: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
}

.text-justify {
    text-align: justify;
}

.gap-large {
    --bs-gutter-x: 5rem;
}

.image-card {
    position: relative;

    &:hover {

        .titre-image,
        .action-image-buttons {
            opacity: 1;
        }

        img {
            filter: brightness(0.3);
        }
    }

    img {
        transition: all 0.3s;
    }

    .titre-image {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0;
        transition: all 0.3s;
    }

    .action-image-buttons {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        padding: 5px;
        display: flex;
        justify-content: space-between;

        opacity: 0;
        transition: all 0.3s;
    }
}

.form-label {
    color: $primary;
}

.allreservations {
    a {
        display: block;
        color: $black;
        padding: 10px;
    }
}

.loader-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.85);
    transition: opacity 0.2s ease;
}
